{
  "name": "MyApp",
  "maintainer": "the maintainer",
  "main_branch": "main",
  "status_file": "docs/STATUS.md",
  "plans_dir": "docs/plans",
  "guard": {
    "real_data": ["%APPDATA%/MyApp", "%LOCALAPPDATA%/MyApp"],
    "secret_dirs": ["~/myapp-keys"],
    "secret_extensions": ["pem", "key", "p8"],
    "self_guarding_scripts": [],
    "maintainer_only": [],
    "app": {
      "commands": ["myapp"],
      "modules": ["myapp"],
      "harmless": [["--version"], ["-v"], ["--help"], ["-h"]],
      "isolate_env": ["APPDATA"],
      "data_folder": "MyApp"
    },
    "ask_release": true,
    "release_stamp": {
      "path": "dist/release_check.passed",
      "binds": "dist/SHA256SUMS.txt",
      "gate": "uv run python tests/release_check.py"
    }
  },
  "checks": {
    "version_files": [
      {"path": "myapp/__init__.py", "pattern": "^__version__ = \"([^\"]+)\""}
    ],
    "no_new_python_comments": ["myapp/"]
  }
}
